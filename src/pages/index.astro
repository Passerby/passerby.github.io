---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="About">
  <section class="space-y-8">
    <div class="grid items-center gap-8 sm:grid-cols-[220px_1fr]">
      <img
        class="mx-auto h-52 w-52 rounded-full border border-border object-cover sm:mx-0"
        src="/assets/img/pro_pic.jpg"
        alt="Rui Du"
      />
      <h1 class="text-center text-5xl font-bold sm:text-left sm:text-6xl">Rui Du</h1>
    </div>

    <div class="border-t border-border pt-6">
      <div class="mb-4 space-y-1">
        <p class="text-2xl font-bold leading-tight">It's the Age of Agents.</p>
        <p class="text-base text-muted-foreground">Copy the prompt below into your AI agent and ask it to explain:</p>
      </div>
      <pre class="overflow-x-auto rounded-lg border border-border p-4 text-sm leading-7 break-words whitespace-pre-wrap">Read this brief and give a concise introduction of Rui Du based on my intent (friendship, technical discussion, hiring, or collaboration), then suggest one practical next step: https://raw.githubusercontent.com/Passerby/passerby.github.io/master/AGENT_BRIEF.md</pre>
    </div>
  </section>
</BaseLayout>
