---
interface Props {
  repository: string;
  showOwner?: boolean;
}

const { repository, showOwner = true } = Astro.props;
const [owner, repo] = repository.split('/');
const title = showOwner ? `${owner}/${repo}` : repo;
---

<a
  class="block rounded-lg border border-border bg-background/60 p-4 transition hover:-translate-y-0.5 hover:border-accent/50 hover:no-underline"
  href={`https://github.com/${repository}`}
  target="_blank"
  rel="noreferrer"
>
  <h3 class="text-xl font-semibold break-words">{title}</h3>
  <p class="mt-2 break-words opacity-70">github.com/{owner}/{repo}</p>
  <span class="mt-3 inline-block font-semibold text-accent">Open on GitHub</span>
</a>
